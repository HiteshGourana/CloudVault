# ==============================================================================
# CloudVault — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ==============================================================================

# ── General Configuration ─────────────────────────────────────────────────────
APP_NAME=CloudVault
APP_VERSION=0.1.0
ENVIRONMENT=development    # Options: development, production, testing
DEBUG=False                # Set to True for verbose error traces locally

# ── Nginx / Network Ports ─────────────────────────────────────────────────────
PORT=8000                  # Port backend API runs on internally
FRONTEND_PORT=80           # Port frontend SPA serves on internally
HOST_PORT=80               # Port exposed on host machine for Nginx Reverse Proxy

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Used by Postgres container inside docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
POSTGRES_DB=cloudvault

# Used by Backend API container to execute SQL transactions
# Inside docker-compose, postgres host resolves to container name 'postgres'
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@postgres:5432/cloudvault

# ── Security Configurations ───────────────────────────────────────────────────
# Generate a strong, secure hex token key: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Fernet symmetric key for encrypting stored AWS secret keys ────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Never lose or change this in production, or existing AWS credentials in DB won't decrypt.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_THIS_TO_A_FERNET_KEY

# ── S3 Configuration Defaults ──────────────────────────────────────────────────
DEFAULT_AWS_REGION=ap-south-1
